# Copy to server/.env (git-ignored). Never put secrets in client/ — anything there ships to the browser.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DUNGEON_SEED=forgotten-dungeon-2026
VOTE_SECONDS=30
ACTION_SECONDS=30
MIN_PLAYERS=1
SPEED_TARGET_MINUTES=30
EVENT_MINUTES=180

# Organiser dashboard password. If unset, a random one is printed at startup.
ADMIN_TOKEN=

# Dungeon Master: "scripted" (no network, default) or "anthropic" (needs a key).
DM_PROVIDER=scripted
ANTHROPIC_API_KEY=
DM_MODEL=claude-haiku-5-5
DM_TIMEOUT_MS=8000
